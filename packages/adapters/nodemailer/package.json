{
  "name": "@custom-auth/nodemailer",
  "version": "1.0.0",
  "description": "Nodemailer email adapter for custom-auth",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.14",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "@custom-auth/core": "1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
